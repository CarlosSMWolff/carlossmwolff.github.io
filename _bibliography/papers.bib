}

@article{rinaldiparameter2024,
  abbr = {Quantum Sci. Technol.},
  title = {Parameter estimation from quantum-jump data using neural networks},
  author = {Rinaldi, Enrico and González Lastre, Manuel and García Herreros, Sergio and Ahmed, Shahnawaz and Khanahmadi, Maryam and Nori, Franco and Sánchez Muñoz, Carlos},
  year = 2024,
  journal = {Quantum Science and Technology},
  volume = {9},
